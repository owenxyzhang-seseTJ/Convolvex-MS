{
  "mcpServers": {
    "convolvex-ms": {
      "command": "/path/to/Convolvex-MS/.venv/bin/python",
      "args": [
        "-u",
        "-m",
        "convolvex.mcp_server",
        "--workspace",
        "/path/to/Convolvex-MS/runtime/ms-stdio"
      ],
      "env": {
        "OPENBLAS_NUM_THREADS": "1",
        "OMP_NUM_THREADS": "1",
        "MKL_NUM_THREADS": "1",
        "PYTHONUTF8": "1"
      }
    }
  }
}
